# Caddy obtains and renews the TLS certificate on its own; nothing to configure
# beyond SITE_DOMAIN in .env and an A record pointing at this server.

{$SITE_DOMAIN} {
	encode zstd gzip

	# Photographs are served under content-addressed names, so they can be
	# cached hard. Everything else is dynamic.
	@media path /media/*
	header @media Cache-Control "public, max-age=31536000, immutable"

	@static path /static/*
	header @static Cache-Control "public, max-age=604800"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# MAX_UPLOAD_MB (50) plus headroom for the multipart envelope. Keep the two
	# in step: below the app's limit and the proxy answers a bare 413 before the
	# request is ever seen, so the owner gets no Russian message and no hint of
	# which file was refused. This was 30MB while the app allowed 50.
	request_body {
		max_size 55MB
	}

	reverse_proxy web:8000
}
