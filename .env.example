# Copy to .env and fill in. .env is git-ignored and must never be committed.

# local | production
ENV=local

# Signs the session cookie. Generate a fresh one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# The single admin account, seeded on first startup.
# Change the password before exposing the site to the internet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Public base URL — used for canonical links, Open Graph tags and sitemap.xml
SITE_URL=http://localhost:8000

# --- Database (compose reads these to start Postgres) ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio

# Used by host-side tooling (alembic, pytest). Inside the container compose
# overrides this to point at the `db` service.
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio
MEDIA_ROOT=./data/media

# --- Uploads ---
MAX_UPLOAD_MB=25
MAX_BATCH_FILES=50
