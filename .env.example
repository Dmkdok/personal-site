# Copy to .env and fill in. .env is git-ignored and must never be committed.

# local | production
ENV=local

# Signs the session cookie. Generate a fresh one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# The single admin account, seeded on first startup. The placeholder below is
# refused at startup — the application will not run until you replace it, and
# under ENV=production it also asks for at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Public base URL — used for canonical links, Open Graph tags and sitemap.xml
SITE_URL=http://localhost:8000

# --- Database (compose reads these to start Postgres) ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio

# Used by host-side tooling (alembic, pytest). Inside the container compose
# overrides this to point at the `db` service.
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio
MEDIA_ROOT=./data/media

# Where the photographs sit on the *host*, bind-mounted to MEDIA_ROOT in the
# container. On a server point this outside the checkout — /srv/portfolio/media
# or a mounted block device — so that re-cloning the repository, `git clean` or
# `docker compose down -v` cannot take the originals with them. Backups read
# the same directory.
MEDIA_HOST_DIR=./data/media

# --- Logging ---
# Where the application writes a copy of its log, in addition to stdout. Leave
# it empty in development: stdout is right there, and nothing new is written on
# your disk. On a server set it to the mount point inside the container
# (/data/logs) so the file can be opened over the share without a Docker client.
# The file rotates at 5 MB and keeps three older ones. An unwritable path is
# never fatal — the application warns and carries on logging to stdout.
LOG_DIR=

# Where that directory lives on the *host*, bind-mounted to LOG_DIR. Its own
# dataset, chowned to uid 1000 like the media one, because the image runs
# unprivileged. Read by docker-compose.prod.yml; the TrueNAS deployment sets it
# as a Portainer stack variable instead.
LOGS_HOST_DIR=./data/logs

# --- Uploads ---
MAX_UPLOAD_MB=50
MAX_BATCH_FILES=50

# --- Production only ---
# Which peers uvicorn may believe when they send X-Forwarded-For. Must name the
# reverse proxy and nothing else: with "*" any client can rewrite its own
# apparent address and buy itself unlimited login attempts. The default is
# Docker's private bridge range, which on this stack is the Caddy container.
TRUSTED_PROXY_IPS=172.16.0.0/12

# What Caddy answers on, and the only difference between the two deployments:
#   a domain — Caddy obtains and renews the certificate itself. Needs an A
#              record pointing here and ports 80/443 reachable from outside.
#   a port   — TLS is terminated upstream and Caddy speaks plain HTTP. A bare
#              port never triggers certificate issuance.
# Required by docker-compose.prod.yml; the TrueNAS deployment sets it inside
# deploy/portainer-stack.yml instead and does not read this file at all.
CADDY_SITE_ADDRESS=example.com

# Which peers Caddy may believe when they send X-Forwarded-For — the same
# question one hop earlier. From an untrusted peer Caddy discards the header and
# substitutes the peer's own address, so behind a proxy every visitor looks like
# that proxy and they share one login-throttle bucket.
CADDY_TRUSTED_PROXIES=private_ranges
