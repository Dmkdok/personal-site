# Store every text file with LF in the repository, whatever the host does.
* text=auto

# Consumed inside Linux containers — CRLF here breaks the build/runtime.
*.sh        text eol=lf
*.py        text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf
Caddyfile   text eol=lf

# Windows-only helper.
*.ps1       text eol=crlf

# Never touch these.
*.woff2 binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
